---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date } = post.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <img src="/rafael-turk.jpeg" alt="" width="28" height="28" />
        <span>Rafael Turk · <time datetime={date.toISOString()}>{formatDate(date)}</time></span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
