---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { BIO, TWITTER, LINKEDIN } from "../../consts";
import { getPosts, formatDate, readingTime } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date } = post.data;
---

<Base title={title} description={description} type="article">
  <a class="back" href="/">← All posts</a>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="meta">
        Rafael Turk · <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <aside class="author">
      <img src="/rafael-turk.jpeg" alt="" width="56" height="56" />
      <p>
        <strong>Written by Rafael Turk</strong><br />
        {BIO} <a href={`https://x.com/${TWITTER}`} target="_blank" rel="noopener">Follow on X</a> · <a href={`https://www.linkedin.com/in/${LINKEDIN}/`} target="_blank" rel="noopener">Connect on LinkedIn</a>
      </p>
    </aside>
  </article>
</Base>
